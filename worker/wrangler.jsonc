{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pixieduster-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],

  // Public URL yes, per-version preview URLs no.
  "workers_dev": true,
  "preview_urls": false,

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },

  // Quota counters. Created with:
  //   npx wrangler d1 create pixieduster-quota
  // then paste the returned database_id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pixieduster-quota",
      "database_id": "c625fd4c-d7e7-4fe5-93d2-8d85dec39ef7"
    }
  ],

  // Burst throttle, keyed on the caller's identity. The daily caps bound how
  // much one visitor gets; this bounds how fast they can take it, so a scripted
  // flood is refused before it costs a charge or reaches Gemini.
  "ratelimits": [
    {
      "name": "BURST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    }
  ],

  // Short-lived cache of verified Hugging Face identities. Created with:
  //   npx wrangler kv namespace create QUOTA_KV
  "kv_namespaces": [
    { "binding": "QUOTA_KV", "id": "757150f796d441e7ac01b3e42f1dc9a2" }
  ],

  // Non-secret knobs. GEMINI_API_KEY is a secret, set with:
  //   npx wrangler secret put GEMINI_API_KEY
  // Declared so `wrangler types` knows about it. The value is never here --
  // set it with:  npx wrangler secret put GEMINI_API_KEY
  "secrets": { "required": ["GEMINI_API_KEY", "TURNSTILE_SECRET", "IP_SALT"] },

  "vars": {
    "DAILY_PER_USER": "5",
    "DAILY_PER_ANON": "2",
    // Interview questions and try-it-out chat turns, which do not spend the
    // persona allowance above.
    "DAILY_AUX_PER_USER": "50",
    "DAILY_AUX_PER_ANON": "30",
    "ALLOWED_ORIGINS": "https://gretchenboria-pixieduster.static.hf.space,https://huggingface.co",
    "DAILY_GLOBAL": "800",
    // Of that ceiling, the most the try-it-out chat may consume, so it cannot
    // starve persona generation.
    "DAILY_AUX_GLOBAL": "400",
    "MAX_BODY_BYTES": "6291456",
    "ALLOWED_MODELS": "gemini-3.6-flash,gemini-2.5-flash,gemini-2.5-flash-lite"
  }
}
